# MCP Hub configuration
# Copy this file to .env and fill in your credentials
#
# cp .env.example .env
#

# Your Jamf Pro instance URL
JAMF_PRO_URL=https://yourcompany.jamfcloud.com

# OAuth Client Credentials
# Create these in Jamf Pro: Settings > System > API Roles and Clients
JAMF_PRO_CLIENT_ID=your-client-id-here
JAMF_PRO_CLIENT_SECRET=your-client-secret-here

JAMF_SECURITY_URL=https://api.wandera.com
JAMF_SECURITY_APP_ID=your-app-id-here
JAMF_SECURITY_APP_SECRET=your-app-secret-here

# Optional read-only Jamf Account Platform environment integration.
# These credentials are separate from the Jamf Pro API client above.
# JAMF_PLATFORM_URL=https://apac.api.jamfcloud.com
# JAMF_PLATFORM_ENVIRONMENT_ID=your-platform-environment-uuid
# JAMF_PLATFORM_CLIENT_ID=your-platform-integration-client-id
# JAMF_PLATFORM_CLIENT_SECRET=your-platform-integration-client-secret

# Optional Jamf Protect tenant
# JAMF_PROTECT_URL=https://yourcompany.protect.jamfcloud.com
# JAMF_PROTECT_CLIENT_ID=your-client-id
# JAMF_PROTECT_PASSWORD=your-client-password

# Protected remote transport only. Configure before using streamable-http.
# Choose oauth (default) or bearer for gateway-held scoped credentials.
# The public resource must be HTTPS in either mode.
# JAMF_MCP_REMOTE_AUTH_MODE=oauth
# JAMF_MCP_OAUTH_ISSUER_URL=https://identity.example.com
# JAMF_MCP_RESOURCE_URL=https://mcp.example.com/mcp
# JAMF_MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# JAMF_MCP_TRANSPORT=streamable-http
# JAMF_MCP_HOST=127.0.0.1
# JAMF_MCP_PORT=8000

# Alternative gateway mode: generate random tokens, never reuse Jamf secrets.
# Store this JSON through your secret manager; the example is deliberately invalid.
# JAMF_MCP_REMOTE_AUTH_MODE=bearer
# JAMF_MCP_BEARER_TOKENS_JSON=[{"identity":"gateway-reader","token":"REPLACE_WITH_RANDOM_SECRET","scopes":["jamf:read"]}]
